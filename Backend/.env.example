# ---- Google AI Studio (https://aistudio.google.com/apikey) ----
GOOGLE_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---- Database ----
# Option 1: Direct DATABASE_URL (for PostgreSQL/MySQL/SQLite in cloud hosting like Supabase, Render, Railway)
# DATABASE_URL=postgresql://user:password@host:port/dbname
# Option 2: Individual MySQL variables (used if DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=learnai_path

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# ---- CORS (Optional) ----
# Comma-separated list of allowed origins (e.g. your Vercel frontend URL)
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5500
